[Unit]
Description=CASM monitor collectors (writes the history store)
After=network-online.target
# Restart backoff: five restarts inside ten minutes and systemd gives up,
# rather than hammering LMC, Redis, Kafka and ssh in a crash loop.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Environment=CASM_MONITOR_CONFIG=%h/software/dev/casm_monitor/config/monitor.yaml
ExecStart=/home/casm/software/dev/casm_venvs/casm_offline_env/bin/casm-monitor-collect
Restart=on-failure
RestartSec=15
MemoryMax=8G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
