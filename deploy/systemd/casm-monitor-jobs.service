[Unit]
Description=CASM monitor background figure worker (imaging disabled)
After=network-online.target
# Restart backoff: five restarts inside ten minutes and systemd gives up,
# rather than hammering LMC, Redis, Kafka and ssh in a crash loop.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
WorkingDirectory=/home/casm/software/dev/casm_monitor
Environment=CASM_MONITOR_CONFIG=%h/software/dev/casm_monitor/config/monitor.yaml
Environment=OPENBLAS_NUM_THREADS=2
Environment=OMP_NUM_THREADS=2
Environment=MPLBACKEND=Agg
ExecStart=/home/casm/software/dev/casm_venvs/casm_offline_env/bin/python -m casm_monitor.jobs.worker --kinds render_figures
Restart=on-failure
RestartSec=15
# Background plots only. Calibration and SNAP acquisition have separate units.
# Keep this budget modest on the shared observing host.
MemoryMax=16G
CPUQuota=400%
Nice=10
IOSchedulingClass=idle
KillMode=control-group
# On stop the worker SIGTERMs the running job's process group itself and marks
# it failed with reason worker_stopped; give it time to do that before systemd
# kills the cgroup.
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
