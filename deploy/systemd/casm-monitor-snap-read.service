[Unit]
Description=CASM monitor dedicated SNAP acquisition worker
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
WorkingDirectory=/home/casm/software/dev/casm_monitor
Environment=CASM_MONITOR_CONFIG=%h/software/dev/casm_monitor/config/monitor.yaml
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/home/casm/software/dev/casm_venvs/casm_offline_env/bin/python -m casm_monitor.jobs.worker --kinds snap_read
Restart=on-failure
RestartSec=15
MemoryMax=2G
CPUQuota=100%
Nice=5
KillMode=control-group
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
